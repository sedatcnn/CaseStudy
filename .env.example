# SQL Server Ayarları
SQL_PASSWORD=Your_Strong_Password_Here

# JWT Ayarları (En az 32 karakter olmalı)
JWT_SECRET_KEY=Your_Secret_Key_At_Least_32_Chars

# Admin Seed Ayarları
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=AdminPassword123!

# RabbitMQ Ayarları
RABBITMQ_USER=guest
RABBITMQ_PASS=guest