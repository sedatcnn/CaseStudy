    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>728f0639-df4d-4409-8ff3-2ae6f00d6131</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
