{
  "ConnectionStrings": {
    "DefaultConnection": "Server=sqlserver,1433;Database=AuthDb;User Id=sa;Password=${SQL_PASSWORD};TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "KayraExport.AuthService",
    "Audience": "KayraExport.Clients",
    "ExpiryMinutes": "60"
  },
  "SeedAdmin": {
    "Email": "${SEED_ADMIN_EMAIL}",
    "Password": "${SEED_ADMIN_PASSWORD}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
